# Model file inside ./models (see scripts/download_model.sh)
MODEL_FILE=Llama-3.2-1B-Instruct-Q4_K_M.gguf

# Context window shared by all slots (tokens)
CTX_SIZE=4096

# Requests the engine can process at the same time
PARALLEL_SLOTS=2

# CPU threads used for generation
THREADS=6

# Host ports (all bound to localhost only)
LLAMA_PORT=8081
GATEWAY_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana admin password (change it if the machine is shared)
GRAFANA_ADMIN_PASSWORD=admin

# --- Gateway (FastAPI) ---
BACKEND=llama_cpp
LLAMA_BASE_URL=http://localhost:8081
BACKEND_TIMEOUT_S=120
MODEL_NAME=llama-3.2-1b-instruct
MAX_PROMPT_CHARS=8000
MAX_TOKENS_LIMIT=1024

# Access control. Format: name:key,name:key (or just key,key). Leave empty to turn
# authentication off (local development only). Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Per-client rate limit (token bucket): sustained requests per minute and burst size.
# 0 turns rate limiting off.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20

# Prompt drift detection: compares the length and language of recent prompts with a reference.
# The reference is the first DRIFT_REFERENCE_SIZE prompts after the first start (Compose keeps it
# in a volume); DRIFT_WINDOW_SIZE is how many recent prompts are compared with it. Scores need at
# least DRIFT_MIN_SAMPLES of them, and below ~100 they are mostly noise. DRIFT_THRESHOLD is the PSI
# above which a feature counts as drifted (0.25 is the usual "significant change"). Without
# Compose, set DRIFT_REFERENCE_FILE to keep the reference between runs.
DRIFT_ENABLED=true
DRIFT_REFERENCE_SIZE=100
DRIFT_WINDOW_SIZE=100
DRIFT_MIN_SAMPLES=100
DRIFT_THRESHOLD=0.25

# Overload protection. With Docker Compose, MAX_CONCURRENT_REQUESTS is taken from
# PARALLEL_SLOTS automatically; this value only matters when running the gateway by hand,
# where it must equal PARALLEL_SLOTS.
MAX_CONCURRENT_REQUESTS=2
MAX_QUEUE_SIZE=8
QUEUE_TIMEOUT_S=30
GENERATION_TIMEOUT_S=120
